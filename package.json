{
  "name": "greenbump",
  "version": "1.0.0",
  "description": "Fixes your code when a dependency major-version bump breaks the build",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "mine": "tsx src/mine.ts",
    "validate": "tsx src/validate.ts",
    "fix": "tsx src/action.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/action.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/action.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
